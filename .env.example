# Copy to `.env` next to docker-compose.yml and fill in what you need.
# Everything here is optional — the widget computes peak/off-peak from the clock
# with no credentials at all. Never commit the filled-in copy.

# --- Optional: account balance row -------------------------------------------
# API key from https://platform.deepseek.com/api_keys
# Leave empty to hide the balance row entirely.
DEEPSEEK_API_KEY=

# Or point at a file instead of an environment variable (Docker secret):
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key

# --- Optional: shared token ---------------------------------------------------
# If set, the widget only answers requests carrying this token, and Glance must
# send it in the widget URL. Useful when the widget is exposed beyond the LAN.
WIDGET_TOKEN=

# --- Display ------------------------------------------------------------------
# 24h (default) or 12h for `7pm` style clocks.
TIME_FORMAT=24h

# --- Data refresh (seconds / hours) ------------------------------------------
# BALANCE_REFRESH_SECONDS=300
# HOLIDAY_REFRESH_HOURS=168

# --- Disable features ---------------------------------------------------------
# BALANCE_DISABLED=1
# HOLIDAYS_DISABLED=1

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
# LOG_LEVEL=info
